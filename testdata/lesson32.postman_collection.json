    {
      "name": "NetworkAI Backend Search By User",
      "request": {
        "auth": {
          "type": "noauth"
        },
        "method": "GET",
        "header": [],
        "url": {
          "raw": "http://{{APPLICATION_URL}}:8080/posts/search?user=sun",
          "protocol": "http",
          "host": [
            "{{APPLICATION_URL}}"
          ],
          "port": "8080",
          "path": [
            "posts",
            "search"
          ],
          "query": [
            {
              "key": "user",
              "value": "sun"
            }
          ]
        }
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Request succeeds\", function () { pm.response.to.have.status(200); });",
              "pm.test(\"Search returns a JSON array\", function () { pm.expect(pm.response.json()).to.be.an(\"array\"); });"
            ]
          }
        }
      ]
    },
    {
      "name": "NetworkAI Backend Search By Keywords",
      "request": {
        "auth": {
          "type": "noauth"
        },
        "method": "GET",
        "header": [],
        "url": {
          "raw": "http://{{APPLICATION_URL}}:8080/posts/search?keywords=this+post",
          "protocol": "http",
          "host": [
            "{{APPLICATION_URL}}"
          ],
          "port": "8080",
          "path": [
            "posts",
            "search"
          ],
          "query": [
            {
              "key": "keywords",
              "value": "this+post"
            }
          ]
        }
