    {
      "name": "Elasticsearch Add Post Test 1",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\r\n  \"id\": \"1\",\r\n  \"user\": \"sun\",\r\n  \"message\": \"This is a post by sun\",\r\n  \"url\": \"https://www.laioffer.com\",\r\n  \"type\": \"image\"\r\n}\r\n"
        },
        "url": {
          "raw": "http://{{APPLICATION_URL}}:9200/post/_doc/1",
          "protocol": "http",
          "host": [
            "{{APPLICATION_URL}}"
          ],
          "port": "9200",
          "path": [
            "post",
            "_doc",
            "1"
          ]
        }
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Document created or updated\", function () { pm.expect(pm.response.code).to.be.oneOf([200, 201]); });"
            ]
          }
        }
      ]
    },
